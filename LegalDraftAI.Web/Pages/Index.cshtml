@section Scripts {
    @if (Model.IsAuthenticated)
    {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const documentType = document.getElementById("Input_DocumentType");
            const factsInput = document.querySelector(".facts-input");
            const sections = document.querySelectorAll(".conditional-section");
            const bailResearchAction = document.querySelector("[data-bail-research-action]");
            const bailFactsPrompt = document.querySelector("[data-bail-facts-prompt]");
            const genericGenerateButton = document.querySelector("[data-generic-generate]");
            const bailUploadRows = document.getElementById("bail-upload-rows");
            const bailUploadTemplate = document.getElementById("bail-upload-row-template");

            function updateBailResearchOption() {
                const hasFacts = factsInput.value.trim().length > 0;
                bailResearchAction.hidden = !hasFacts;
                bailFactsPrompt.hidden = hasFacts;
            }

            function updateConditionalFields() {
                const absenceApplicationSelected = documentType.value === "AbsenceApplication";
                const civilPlaintSelected = documentType.value === "CivilPlaint";
                const bailApplicationSelected = documentType.value === "BailApplication";
                sections.forEach((section) => {
                    section.hidden = section.dataset.documentType !== documentType.value;
                });

                document.querySelectorAll(".absence-required").forEach((input) => {
                    input.required = absenceApplicationSelected;
                });
                document.querySelectorAll(".bail-required").forEach((input) => {
                    input.required = bailApplicationSelected;
                });
                document.querySelector(".facts-input").required = !absenceApplicationSelected;
                document.querySelector(".default-facts-label").hidden = absenceApplicationSelected;
                document.querySelector(".absence-facts-label").hidden = !absenceApplicationSelected;
                document.querySelector(".default-facts-hint").hidden = absenceApplicationSelected;
                document.querySelector(".absence-facts-hint").hidden = !absenceApplicationSelected;
                genericGenerateButton.hidden = civilPlaintSelected ||
                    bailApplicationSelected && genericGenerateButton.dataset.bailResearched !== "true";
                updateBailResearchOption();
            }

            documentType.addEventListener("change", updateConditionalFields);
            factsInput.addEventListener("input", () => {
                genericGenerateButton.dataset.bailResearched = "false";
                updateConditionalFields();
            });
            document.getElementById("add-bail-upload")?.addEventListener("click", () => {
                bailUploadRows.append(bailUploadTemplate.content.cloneNode(true));
            });
            bailUploadRows?.addEventListener("click", (event) => {
                if (event.target.closest(".remove-upload-button"))
                    event.target.closest(".upload-row").remove();
            });
            updateConditionalFields();
        })();
    </script>
    }
    else
    {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const tabs = document.querySelectorAll("[data-auth-tab]");
            const panels = document.querySelectorAll("[data-auth-panel]");

            function selectMode(mode) {
                panels.forEach((panel) => { panel.hidden = panel.dataset.authPanel !== mode; });
                tabs.forEach((tab) => {
                    const active = tab.dataset.authTab === mode;
                    tab.classList.toggle("is-active", active);
                    if (tab.hasAttribute("aria-selected")) tab.setAttribute("aria-selected", String(active));
                });
                const firstInput = document.querySelector(`[data-auth-panel="${mode}"] input:not([type="hidden"])`);
                if (firstInput) firstInput.focus();
            }

            tabs.forEach((tab) => tab.addEventListener("click", () => selectMode(tab.dataset.authTab)));
        })();
    </script>
    }
}
