@page
@model IndexModel
@{
    ViewData["Title"] = Model.IsAuthenticated ? "Generate a draft" : "Sign in";
    ViewData["IsAuthLanding"] = !Model.IsAuthenticated;
    ViewData["AccountDisplayName"] = Model.AccountDisplayName;
}

@if (Model.IsAuthenticated)
{
<section class="hero">
    <p class="eyebrow">LEGAL DRAFT AI</p>
    <h1>Build a first draft from your case facts.</h1>
    <p class="hero-copy">Choose a document, provide the facts, and review the generated draft before using it.</p>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ApiStatusMessage))
{
    <div class="notice notice-warning" role="status">@Model.ApiStatusMessage</div>
}

<div class="workspace">
    <form method="post" class="draft-form" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <section class="form-section">
            <div class="section-heading">
                <span class="section-number">01</span>
                <div>
                    <h2>Draft details</h2>
                    <p>Tell us what kind of document to prepare and where it will be filed.</p>
                </div>
            </div>

            <div class="field-grid">
                <div class="field">
                    <label asp-for="Input.DocumentType">Document type <span class="required-mark">*</span></label>
                    <select asp-for="Input.DocumentType" class="form-select" required>
                        <option value="">Select a document type</option>
                        @foreach (var documentType in Model.DocumentTypes)
                        {
                            <option value="@documentType.Value">@documentType.Label</option>
                        }
                    </select>
                    <span asp-validation-for="Input.DocumentType" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Jurisdiction">Jurisdiction</label>
                    <input asp-for="Input.Jurisdiction" class="form-control" placeholder="e.g. Delhi" />
                    <span asp-validation-for="Input.Jurisdiction" class="field-error"></span>
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-heading">
                <span class="section-number">02</span>
                <div>
                    <h2>Client facts</h2>
                    <p>Include names, dates, case details, events, and any other relevant information.</p>
                </div>
            </div>

            <div class="field">
                <label asp-for="Input.ExtractedClientFacts">
                    <span class="default-facts-label">Facts for the draft <span class="required-mark">*</span></span>
                    <span class="absence-facts-label" hidden>Additional facts <span class="optional-tag">Optional</span></span>
                </label>
                <textarea asp-for="Input.ExtractedClientFacts" class="form-control facts-input" rows="9"
                          placeholder="Describe the matter in your own words. Include known case numbers and dates, and leave out details that are not confirmed."
                          required></textarea>
                <div class="field-hint default-facts-hint">Required. Do not include confidential information unless you are authorized to share it with the configured drafting service.</div>
                <div class="field-hint absence-facts-hint" hidden>All fields above are included with your case details. Add any relevant context here if needed.</div>
                <span asp-validation-for="Input.ExtractedClientFacts" class="field-error"></span>
            </div>
        </section>

        <section class="form-section conditional-section" data-document-type="BailApplication" hidden>
            <div class="section-heading">
                <span class="section-number">03</span>
                <div>
                    <h2>Research bail supporting documents</h2>
                    <p>Use the case facts to prepare a bail-document checklist, then upload and map the supporting records you have.</p>
                </div>
            </div>
            <p class="field-hint" data-bail-facts-prompt>Enter the client facts above to enable document research.</p>
            <div class="form-actions" data-bail-research-action hidden>
                <p>Step 1 · Research documents for this bail application</p>
                <button type="submit" class="secondary-button" formaction="?handler=ResearchBail" formnovalidate>
                    Research documents <span aria-hidden="true">→</span>
                </button>
            </div>

            @if (Model.BailResearchResult is not null)
            {
                <div class="subsection-heading">
                    <h3>@Model.BailResearchResult.PlaintNatureLabel</h3>
                    <p>@Model.BailResearchResult.Summary</p>
                </div>
                @if (Model.BailResearchResult.RequiredDocuments.Count > 0)
                {
                    @if (!string.IsNullOrWhiteSpace(Model.BailUploadStatusMessage))
                    {
                        <div class="upload-success" role="status">@Model.BailUploadStatusMessage</div>
                    }
                    <p class="checklist-instructions">Tick any supporting records already available. Checklist results are informational; confirm case-specific requirements with counsel.</p>
                    <div class="document-checklist">
                        @foreach (var document in Model.BailResearchResult.RequiredDocuments)
                        {
                            var alreadyHave = Model.BailResearchResult.AlreadyHave.Contains(document.Code, StringComparer.OrdinalIgnoreCase);
                            <label class="document-row">
                                <input type="checkbox"
                                       name="Input.AlreadyHaveDocumentCodes"
                                       value="@document.Code"
                                       checked="@alreadyHave" />
                                <span class="document-label">
                                    <strong>@document.Label</strong>
                                    <small>@document.Purpose · @document.Code</small>
                                </span>
                                <span class="priority-badge priority-@document.Priority.ToLowerInvariant()">@document.Priority</span>
                                <span class="document-status @(alreadyHave ? "document-status-have" : "document-status-missing")">
                                    @(alreadyHave ? "Already have" : "Missing")
                                </span>
                            </label>
                        }
                    </div>
                    <div class="checklist-summary @(Model.BailResearchResult.CanFileWithMinimumSet ? "checklist-complete" : "checklist-incomplete")">
                        <strong>@(Model.BailResearchResult.MissingMandatory.Count == 0 ? "Critical checklist items marked available." : $"{Model.BailResearchResult.MissingMandatory.Count} critical checklist item(s) not yet marked available.")</strong>
                        <span>Upload related documents below or update the checklist if the client already has them.</span>
                    </div>

                    <div class="subsection-heading">
                        <h3>Upload related documents</h3>
                        <p>Map each file to the matching checklist item. Supported formats: PDF, DOCX, TXT, PNG, JPG, TIFF, BMP, GIF, and WebP.</p>
                    </div>
                    <div id="bail-upload-rows">
                        <div class="upload-row">
                            <div class="field">
                                <label>Document file</label>
                                <input class="form-control" type="file" name="files" accept=".pdf,.docx,.txt,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.gif,.webp" />
                            </div>
                            <div class="field">
                                <label>Checklist document</label>
                                <select class="form-select" name="documentCodes">
                                    <option value="">Map this file to a document</option>
                                    @foreach (var document in Model.BailResearchResult.RequiredDocuments)
                                    {
                                        <option value="@document.Code">@document.Label (@document.Code)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <template id="bail-upload-row-template">
                        <div class="upload-row">
                            <div class="field">
                                <label>Document file</label>
                                <input class="form-control" type="file" name="files" accept=".pdf,.docx,.txt,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.gif,.webp" />
                            </div>
                            <div class="field">
                                <label>Checklist document</label>
                                <select class="form-select" name="documentCodes">
                                    <option value="">Map this file to a document</option>
                                    @foreach (var document in Model.BailResearchResult.RequiredDocuments)
                                    {
                                        <option value="@document.Code">@document.Label (@document.Code)</option>
                                    }
                                </select>
                            </div>
                            <button type="button" class="remove-upload-button" aria-label="Remove this upload">Remove</button>
                        </div>
                    </template>
                    <div class="upload-actions">
                        <button type="button" class="text-button" id="add-bail-upload">+ Add another document</button>
                        <button type="submit" class="secondary-button" formaction="?handler=UploadBail" formnovalidate>
                            Upload and extract <span aria-hidden="true">↑</span>
                        </button>
                    </div>
                    @if (Model.BailUploadedDocuments.Count > 0)
                    {
                        <details class="civil-plaint-collapsible-list" open>
                            <summary class="uploaded-heading">Uploaded documents (@Model.BailUploadedDocuments.Count)</summary>
                            <ul class="uploaded-list">
                                @foreach (var upload in Model.BailUploadedDocuments)
                                {
                                    var label = Model.BailResearchResult.RequiredDocuments
                                        .FirstOrDefault(document => document.Code.Equals(upload.DocumentCode, StringComparison.OrdinalIgnoreCase))?.Label ?? upload.DocumentCode;
                                    <li>
                                        <strong>@label</strong>
                                        <span>@upload.FileName</span>
                                        <details>
                                            <summary>Review extracted text</summary>
                                            @if (string.IsNullOrWhiteSpace(upload.Text))
                                            {
                                                <p class="field-hint">No readable text was extracted. Check the original file and upload a clearer copy if needed.</p>
                                            }
                                            else
                                            {
                                                <pre class="result-json">@upload.Text</pre>
                                                <p class="field-hint">Verify extracted text against the original. OCR can contain errors.</p>
                                            }
                                        </details>
                                    </li>
                                }
                            </ul>
                        </details>
                    }

                    <details class="form-section civil-plaint-collapsible-section" open>
                        <summary class="section-heading">
                            <span class="section-number">04</span>
                            <div>
                                <h2>Court and suit</h2>
                                <p>Enter the court, case particulars, and parties for this new client.</p>
                            </div>
                        </summary>
                        <div class="field-grid">
                            <div class="field">
                                <label asp-for="Input.CourtName">Court name <span class="required-mark">*</span></label>
                                <input asp-for="Input.CourtName" class="form-control bail-required" placeholder="e.g. Court of the Sessions Judge, Jaipur" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.CaseTitle">Case title <span class="required-mark">*</span></label>
                                <input asp-for="Input.CaseTitle" class="form-control bail-required" placeholder="Applicant v. State" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.CaseNumber">Case / application number <span class="optional-tag">Optional if not assigned</span></label>
                                <input asp-for="Input.CaseNumber" class="form-control" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.ApplicantName">Applicant / accused name <span class="required-mark">*</span></label>
                                <input asp-for="Input.ApplicantName" class="form-control bail-required" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.BailApplicantAddress">Applicant address</label>
                                <textarea asp-for="Input.BailApplicantAddress" class="form-control" rows="2" placeholder="Current address, if relevant to the application"></textarea>
                            </div>
                            <div class="field">
                                <label asp-for="Input.OppositePartyName">Respondent / State <span class="required-mark">*</span></label>
                                <input asp-for="Input.OppositePartyName" class="form-control bail-required" placeholder="e.g. State of Rajasthan" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.FirNumber">FIR / complaint number</label>
                                <input asp-for="Input.FirNumber" class="form-control" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.PoliceStation">Police station</label>
                                <input asp-for="Input.PoliceStation" class="form-control" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.District">District</label>
                                <input asp-for="Input.District" class="form-control" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.Sections">Applicable sections</label>
                                <input asp-for="Input.Sections" class="form-control" placeholder="BNS / BNSS sections, if known" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.BailType">Bail application type <span class="required-mark">*</span></label>
                                <select asp-for="Input.BailType" class="form-select bail-required">
                                    <option value="">Select application type</option>
                                    <option value="Regular bail">Regular bail</option>
                                    <option value="Anticipatory bail">Anticipatory bail</option>
                                    <option value="Interim bail">Interim bail</option>
                                    <option value="Other bail application">Other bail application</option>
                                </select>
                            </div>
                        </div>
                    </details>

                    <details class="form-section civil-plaint-collapsible-section" open>
                        <summary class="section-heading">
                            <span class="section-number">05</span>
                            <div>
                                <h2>Facts and relief</h2>
                                <p>Provide the factual background and grounds for the requested bail relief.</p>
                            </div>
                        </summary>
                        <div class="field-grid field-grid-spaced">
                            <div class="field">
                                <label asp-for="Input.BailAllegations">Allegations and factual chronology <span class="required-mark">*</span></label>
                                <textarea asp-for="Input.BailAllegations" class="form-control bail-required" rows="5" placeholder="State the events, dates, allegations, and procedural history as accurately as known."></textarea>
                            </div>
                            <div class="field">
                                <label asp-for="Input.BailCustodyStatus">Arrest / custody status <span class="required-mark">*</span></label>
                                <textarea asp-for="Input.BailCustodyStatus" class="form-control bail-required" rows="3" placeholder="Whether arrested, in custody, surrendered, or apprehending arrest; include dates if known."></textarea>
                            </div>
                            <div class="field">
                                <label asp-for="Input.BailGrounds">Grounds for bail <span class="required-mark">*</span></label>
                                <textarea asp-for="Input.BailGrounds" class="form-control bail-required" rows="4" placeholder="Enter case-specific grounds supported by the known facts."></textarea>
                            </div>
                            <div class="field">
                                <label asp-for="Input.BailPrayer">Prayer / relief sought <span class="required-mark">*</span></label>
                                <textarea asp-for="Input.BailPrayer" class="form-control bail-required" rows="3" placeholder="Describe the bail relief requested; counsel should confirm the applicable wording."></textarea>
                            </div>
                        </div>
                    </details>

                    <details class="form-section civil-plaint-collapsible-section" open>
                        <summary class="section-heading">
                            <span class="section-number">06</span>
                            <div>
                                <h2>Filing details</h2>
                                <p>Details used for the place, date, and advocate signature portion.</p>
                            </div>
                        </summary>
                        <div class="field-grid">
                            <div class="field">
                                <label asp-for="Input.Place">Place <span class="required-mark">*</span></label>
                                <input asp-for="Input.Place" class="form-control bail-required" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.ApplicationDate">Date <span class="required-mark">*</span></label>
                                <input asp-for="Input.ApplicationDate" type="date" class="form-control bail-required" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.AdvocateName">Advocate name <span class="required-mark">*</span></label>
                                <input asp-for="Input.AdvocateName" class="form-control bail-required" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.AdvocateEnrollmentNo">Advocate enrollment number</label>
                                <input asp-for="Input.AdvocateEnrollmentNo" class="form-control" />
                            </div>
                        </div>
                    </details>
                }
                else
                {
                    <p class="result-error">@Model.BailResearchResult.Summary</p>
                }
            }
        </section>

        <section class="form-section conditional-section" data-document-type="CivilPlaint" hidden>
            <div class="section-heading">
                <span class="section-number">03</span>
                <div>
                    <h2>Guided Civil Plaint workflow</h2>
                    <p>Research supporting documents from your case facts, upload and map related files, then complete the court, party, property, relief, and filing sections.</p>
                </div>
            </div>
            <p class="field-hint">Your facts and jurisdiction will be carried into the Civil Plaint page. You can review or edit them before running research.</p>
            <div class="form-actions">
                <button type="submit" class="generate-button" formaction="?handler=ContinueCivilPlaint" formnovalidate>
                    Continue to research and complete plaint <span aria-hidden="true">→</span>
                </button>
            </div>
        </section>

        <section class="form-section conditional-section" data-document-type="AbsenceApplication" hidden>
            <div class="section-heading">
                <span class="section-number">03</span>
                <div>
                    <h2>Absence / exemption application</h2>
                    <p>Complete the application details. Fields marked with an asterisk are required.</p>
                </div>
            </div>
            <div class="field-grid">
                <div class="field">
                    <label asp-for="Input.CourtName">Court name <span class="required-mark">*</span></label>
                    <input asp-for="Input.CourtName" class="form-control absence-required" placeholder="e.g. Court of the Metropolitan Magistrate" />
                    <span asp-validation-for="Input.CourtName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.CaseTitle">Case title <span class="required-mark">*</span></label>
                    <input asp-for="Input.CaseTitle" class="form-control absence-required" placeholder="e.g. State vs Ramesh Kumar" />
                    <span asp-validation-for="Input.CaseTitle" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.CaseNumber">Case number <span class="required-mark">*</span></label>
                    <input asp-for="Input.CaseNumber" class="form-control absence-required" placeholder="e.g. CC No. 245/2025" />
                    <span asp-validation-for="Input.CaseNumber" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.HearingDate">Hearing date <span class="required-mark">*</span></label>
                    <input asp-for="Input.HearingDate" type="date" class="form-control absence-required" />
                    <span asp-validation-for="Input.HearingDate" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.ApplicantName">Applicant name <span class="required-mark">*</span></label>
                    <input asp-for="Input.ApplicantName" class="form-control absence-required" placeholder="Party seeking exemption" />
                    <span asp-validation-for="Input.ApplicantName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.ApplicantStatus">Applicant status <span class="required-mark">*</span></label>
                    <select asp-for="Input.ApplicantStatus" class="form-select absence-required">
                        <option value="">Select status</option>
                        <option value="Accused">Accused</option>
                        <option value="Plaintiff">Plaintiff</option>
                        <option value="Defendant">Defendant</option>
                        <option value="Petitioner">Petitioner</option>
                        <option value="Complainant">Complainant</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Input.ApplicantStatus" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.OppositePartyName">Opposite party name <span class="required-mark">*</span></label>
                    <input asp-for="Input.OppositePartyName" class="form-control absence-required" placeholder="Name of the other side" />
                    <span asp-validation-for="Input.OppositePartyName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.ReasonForAbsence">Reason for absence <span class="required-mark">*</span></label>
                    <input asp-for="Input.ReasonForAbsence" class="form-control absence-required" placeholder="e.g. Medical grounds, out of station, another court" />
                    <span asp-validation-for="Input.ReasonForAbsence" class="field-error"></span>
                </div>
            </div>

            <div class="subsection-heading">
                <h3>Criminal case details <span class="optional-tag">If applicable</span></h3>
                <p>FIR, police station, district and sections are optional for non-criminal cases.</p>
            </div>
            <div class="field-grid">
                <div class="field">
                    <label asp-for="Input.FirNumber">FIR number</label>
                    <input asp-for="Input.FirNumber" class="form-control" />
                </div>
                <div class="field">
                    <label asp-for="Input.PoliceStation">Police station</label>
                    <input asp-for="Input.PoliceStation" class="form-control" />
                </div>
                <div class="field">
                    <label asp-for="Input.District">District</label>
                    <input asp-for="Input.District" class="form-control" />
                </div>
                <div class="field">
                    <label asp-for="Input.Sections">Sections</label>
                    <input asp-for="Input.Sections" class="form-control" placeholder="e.g. Sections 420, 406 BNS" />
                </div>
            </div>

            <div class="subsection-heading">
                <h3>Signature block</h3>
                <p>Advocate and application details printed at the bottom of the draft.</p>
            </div>
            <div class="field-grid">
                <div class="field">
                    <label asp-for="Input.AdvocateName">Advocate name <span class="required-mark">*</span></label>
                    <input asp-for="Input.AdvocateName" class="form-control absence-required" />
                    <span asp-validation-for="Input.AdvocateName" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.AdvocateEnrollmentNo">Advocate enrollment number</label>
                    <input asp-for="Input.AdvocateEnrollmentNo" class="form-control" />
                </div>
                <div class="field">
                    <label asp-for="Input.Place">Place <span class="required-mark">*</span></label>
                    <input asp-for="Input.Place" class="form-control absence-required" placeholder="Place of application" />
                    <span asp-validation-for="Input.Place" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.ApplicationDate">Date of application <span class="required-mark">*</span></label>
                    <input asp-for="Input.ApplicationDate" type="date" class="form-control absence-required" />
                    <span asp-validation-for="Input.ApplicationDate" class="field-error"></span>
                </div>
            </div>

            <div class="subsection-heading">
                <h3>Standard grounds <span class="optional-tag">Optional</span></h3>
                <p>Select any grounds that apply. The selected codes are sent in <code>ExtraFields</code>.</p>
            </div>
            @if (Model.AbsenceGrounds.Count == 0)
            {
                <p class="field-hint">Ground options are unavailable while the API is offline.</p>
            }
            else
            {
                <div class="choice-grid">
                    @foreach (var ground in Model.AbsenceGrounds)
                    {
                        <label class="choice-card">
                            <input type="checkbox" name="Input.SelectedGroundCodes" value="@ground.Code"
                                   checked="@Model.Input.SelectedGroundCodes.Contains(ground.Code)" />
                            <span>@ground.Label</span>
                        </label>
                    }
                </div>
            }
        </section>

        <section class="form-section conditional-section" data-document-type="CertifiedCopyApplication" hidden>
            <div class="section-heading">
                <span class="section-number">03</span>
                <div>
                    <h2>Documents to request <span class="optional-tag">Optional</span></h2>
                    <p>Select the certified copies needed. The selected codes are sent in <code>ExtraFields</code>.</p>
                </div>
            </div>
            @if (Model.CourtDocuments.Count == 0)
            {
                <p class="field-hint">Document options are unavailable while the API is offline.</p>
            }
            else
            {
                <div class="choice-grid">
                    @foreach (var document in Model.CourtDocuments)
                    {
                        <label class="choice-card">
                            <input type="checkbox" name="Input.SelectedDocumentCodes" value="@document.Code"
                                   checked="@Model.Input.SelectedDocumentCodes.Contains(document.Code)" />
                            <span>@document.Label</span>
                        </label>
                    }
                </div>
            }
        </section>

        <details class="advanced-fields">
            <summary>Advanced extra fields <span class="optional-tag">Optional</span></summary>
            <p>Pass any additional API-specific fields as a JSON object. Values must be strings.</p>
            <div class="field">
                <label asp-for="Input.ExtraFieldsJson">Extra fields JSON</label>
                <textarea asp-for="Input.ExtraFieldsJson" class="form-control code-input" rows="4"
                          placeholder='{"additionalContext": "Any additional context"}'></textarea>
                <span asp-validation-for="Input.ExtraFieldsJson" class="field-error"></span>
            </div>
        </details>

        <div class="form-actions">
            <p><span class="required-mark">*</span> Required fields</p>
            <button type="submit" class="generate-button" data-generic-generate data-bail-researched="@(Model.BailResearchResult is not null ? "true" : "false")">
                Generate draft <span aria-hidden="true">→</span>
            </button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ApiErrorMessage) || !string.IsNullOrWhiteSpace(Model.GeneratedDraftJson))
    {
        <section class="result-panel" aria-live="polite">
            <div class="result-heading">
                <div>
                    <p class="eyebrow">API RESPONSE</p>
                    <h2>@(Model.ApiErrorMessage is null ? "Draft generated" : "Request details")</h2>
                </div>
                @if (Model.ApiErrorMessage is not null)
                {
                    <span class="result-status result-status-error">Needs attention</span>
                }
                else
                {
                    <span class="result-status">Review before use</span>
                }
            </div>
            @if (Model.ApiErrorMessage is not null)
            {
